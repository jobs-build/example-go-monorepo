# BUILD.jobs — build one member of a Go monorepo with JOBS (source closure).
#
# plugins(): declares the "go" build plugin in CLOSURE mode (source-closure
#            design §8): go_closure=["."] alongside go_mod makes the plugin
#            walk the transitive local import graph and return the //-rooted
#            COMPLETE cover in res["closure"] — reached sibling package dirs
#            (here //lib/common), this module's own files, and the module
#            manifests.
# build():   forwards res["closure"] into closure=, so the build is keyed on
#            EXACTLY its inputs at package-dir granularity: an edit to
#            anything outside the reached packages — docs/, go.work, an
#            unimported sibling package — memo-hits. (Files inside a reached
#            package dir are inputs, stray or not: that is the granularity.)
#            The sibling still lands at $SRC_ROOT/lib/common with
#            the repo-relative layout intact, so `replace … => ../../lib/common`
#            just works. Everything else is the standard offline, CGO-free
#            Go build (toolchain via tarball+https, GOPROXY=off).
#
# Requires jobs-iroh >= v0.12.0 (closure=) and plugin-go >= v0.1.0
# (go_closure): https://github.com/jobs-build/plugin-go/releases/tag/v0.1.0

# Recipe-declared fetchers (JOBS 2026-07-10 design): the plugin build is
# pinned here; plugin artifacts bundle their companion fetcher pins.
GOPLUGIN = fetcher(
    name   = "goplugin",
    url    = "https://github.com/jobs-build/plugin-go/archive/refs/tags/v0.1.0.tar.gz",
    sha256 = "5e578163461a36e4587ec1e312a43a37d7aa466a65e01e381ff75c9cee1b54ef",
)

def plugins():
    return {"go": imp(fetcher = GOPLUGIN, params = {})}

def build():
    # The Go toolchain tarball is named by GOARCH (amd64/arm64); the script
    # body below is arch-agnostic (GOROOT-relative), so only the toolchain
    # URL + sha256 are selected per-arch.
    goarch = {"linux/amd64": "amd64", "linux/arm64": "arm64"}[platform]
    go_sha = {
        "amd64": "1153d3d50e0ac764b447adfe05c2bcf08e889d42a02e0fe0259bd47f6733ad7f",
        "arm64": "ef758ae7c6cf9267c9c0ef080b8965f453d89ab2d25d9eb22de4405925238768",
    }
    toolchain = imp(fetcher = "tarball+https", params = {
        "url": "https://go.dev/dl/go1.26.4.linux-" + goarch + ".tar.gz",
        "sha256": go_sha[goarch],
    })

    # Closure mode: go_mod + go_closure flip the plugin response to
    # {modules, sources, closure}. This module has ZERO external deps, so
    # there is no go.sum — the plugin requires the kwarg, so pass "" and
    # modules comes back empty. The module staging loop below is kept anyway:
    # add a `require` to go.mod + go.sum and it starts fetching, exactly like
    # the go-build example.
    res = plugins["go"](go_sum = "", go_mod = source.read("go.mod"), go_closure = ["."])

    inputs = {"toolchain": toolchain}
    copies = []
    for m in res["modules"]:
        name = "mod_" + m["path"].replace("/", "_").replace(".", "_").replace("-", "_")
        inputs[name] = m["input"]
        # Each module input's tree is rooted at cache/download/...; stage it in.
        copies.append('cp -dr "$(jq -r .%s <<<"$JOBS_DEPS")/." "$GOMODCACHE/"' % name)

    # Stage the toolchain (+ module cache) from the read-only /jobs/store into
    # the writable build tree, then build from local disk (the Go toolchain's
    # hot path does not love the on-demand FUSE store — see go-build).
    # CWD is already $SRC = /build/src/services/api; the covered sibling is at
    # $SRC_ROOT/lib/common, i.e. ../../lib/common — the replace directive
    # resolves without any recipe-side path surgery. GOWORK=off keeps the
    # build pinned to this module even though the repo root carries a go.work.
    script = """
export GOROOT=/build/goroot
mkdir -p "$GOROOT" "$out"
cp -dr "$(jq -r .toolchain <<<"$JOBS_DEPS")/go/." "$GOROOT/"
export PATH="$GOROOT/bin:$PATH"
export GOMODCACHE=/build/gomodcache GOCACHE=/go-build-cache GOPATH=/build/gopath
export GOPROXY=off GOSUMDB=off GOFLAGS=-mod=mod GOTOOLCHAIN=local CGO_ENABLED=0 GOWORK=off
mkdir -p "$GOMODCACHE/cache/download"
""" + "\n".join(copies) + """
chmod -R u+w "$GOROOT" "$GOMODCACHE" 2>/dev/null || true
cd "$SRC"
go build -o "$out/api" ./...
cat > "$out/JOBS.entrypoint" <<'EOF'
{"command": "api", "args": [], "env": {}}
EOF
"""

    return struct(
        name = "example-go-monorepo api",
        inputs = inputs,
        env = {},
        script = script,
        runtime_deps = [],
        # The COMPLETE cover: the plugin-walked import closure — reached
        # sibling packages, this module's own files, the manifests. No dir
        # seed: this is EXACTLY what the build is keyed on (KP) — edits
        # anywhere else in the repo (docs/, go.work, unimported sibling
        # packages) memo-hit.
        closure = res["closure"],
        # Persistent Go build cache (GOCACHE above): rebuilds recompile only
        # what changed. Keyed to the toolchain release; platform is
        # auto-appended by the runner. Pruned to what the build accessed
        # (atime), uploaded on success only.
        caches = {"/go-build-cache": "example-go-monorepo-go1.26.4"},
    )
